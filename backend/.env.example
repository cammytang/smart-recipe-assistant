# Smart Recipe Assistant backend configuration
# Copy this file to .env and replace placeholder values as needed.

# LLM configuration
# Examples of providers supported by the current code: qwen, ollama, lmstudio.
LLM_PROVIDER=qwen
LLM_MODEL_ID=your-model-id
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1

# Local model settings (used by ollama/lmstudio configurations)
LOCAL_LLM=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Embedding configuration for recipe RAG
# If these are omitted, the code falls back to OPENAI_* and then LLM_* values.
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional OpenAI-compatible fallback used by the embedding service
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Search configuration: duckduckgo, tavily, perplexity, searxng, or advanced
SEARCH_API=duckduckgo
# Required only when SEARCH_API=tavily
# TAVILY_API_KEY=your-tavily-api-key

# Agent behavior
MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=true
STRIP_THINKING_TOKENS=true
USE_TOOL_CALLING=false

# Notes and local recipe retrieval
ENABLE_NOTES=true
NOTES_WORKSPACE=./notes
RECIPE_RAG_LIMIT=5
# Optional minimum similarity score; leave unset to disable the threshold.
# RECIPE_RAG_SCORE_THRESHOLD=0.5
